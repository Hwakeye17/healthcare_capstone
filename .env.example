GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TEMPERATURE=0
MOCK_LLM=true
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true

# Per-request usage guard. Token counts and costs are estimates, not billing.
MAX_REQUEST_INPUT_TOKENS=8192
MAX_TOTAL_ESTIMATED_TOKENS=65536
MAX_COMPLETION_TOKENS_PER_CALL=1024
MAX_ESTIMATED_COST_USD=0.10
INPUT_COST_PER_MILLION_TOKENS_USD=0.80
OUTPUT_COST_PER_MILLION_TOKENS_USD=4.00

# JSON Lines application log; do not commit generated log files.
PRACTO_LOG_PATH=logs/practo_agent.jsonl
